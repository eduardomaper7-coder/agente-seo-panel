# Copia este archivo como .env.local y rellena los valores reales.
# Nunca subas .env.local a GitHub (ya está en .gitignore).

# --- Supabase (proyecto del panel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo la usa el agente y las rutas internas, nunca el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (cuenta administradora: aibe.technologies7@gmail.com) ---
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_PAGESPEED_API_KEY=

# --- Yandex Metrika (opcional) ---
# La web ya tiene instalado el contador de Yandex Metrika (mapas de calor,
# grabación de sesiones, clickmap — gratis e ilimitado). Sin este token el
# informe mensual simplemente omite la sección de tráfico/mapas de calor y
# enlaza directamente al panel de Yandex en su lugar. Token OAuth desde
# https://oauth.yandex.com (crear una app con permiso de lectura de
# Metrika) — ver README.
YANDEX_METRIKA_TOKEN=

# --- Envío de correo de outreach de prensa ---
# contenidos.locales10@gmail.com — usar contraseña de aplicación de Gmail
# (no la contraseña normal de la cuenta) una vez actives la verificación en dos pasos.
GMAIL_OUTREACH_ADDRESS=contenidos.locales10@gmail.com
GMAIL_OUTREACH_APP_PASSWORD=

# --- GitHub (repos de clientes) ---
# Token de acceso de grano fino, limitado repo a repo — ver README.
GITHUB_TOKEN=

# --- Endpoint interno de actualización de posiciones (Search Console) ---
# Secreto compartido que protege GET /api/gsc/actualizar-posiciones — evita
# que cualquiera lo dispare sin más. Genera uno propio, ej. con
# `openssl rand -hex 24`.
INTERNAL_CRON_SECRET=
